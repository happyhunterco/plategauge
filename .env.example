# ---- App (public: these ship inside the app bundle) ----
# Site origin that serves /api/* (your Netlify site). Leave empty to run without a server.
EXPO_PUBLIC_API_URL=
# Supabase project (Settings → API). The anon key is public by design; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# development | preview | production. Production builds ignore development data.
EXPO_PUBLIC_APP_ENV=development
# Set to "development" for labeled test data and device-only accounts (never in production)
EXPO_PUBLIC_DATA_MODE=development
# Store listing and legal links (badges and links stay hidden until set)
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_GOOGLE_PLAY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
# Optional: basic request tag checked by the server (not a secret; anyone can read it from the app)
EXPO_PUBLIC_APP_KEY=

# ---- Server (secret: set these in Netlify → Site configuration → Environment variables) ----
# ANTHROPIC_API_KEY=         required for meal photos, label reading, Describe, Kitchen, mood ideas
# ANTHROPIC_MODEL=           optional, default claude-sonnet-5
# USDA_FDC_API_KEY=          free at https://fdc.nal.usda.gov/api-key-signup
# NUTRITIONIX_APP_ID=        licensed; restaurants + US grocery
# NUTRITIONIX_APP_KEY=
# FATSECRET_CLIENT_ID=       licensed; restaurants + brands
# FATSECRET_CLIENT_SECRET=
# FATSECRET_SCOPE=basic      use "basic barcode" if your plan includes barcode lookup
# SUPABASE_URL=              same project URL as above
# SUPABASE_SERVICE_ROLE_KEY= secret; used only by /api/account/delete
# APP_KEY=                   must match EXPO_PUBLIC_APP_KEY if you set one
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_WEBHOOK_SECRET=
PUBLIC_SITE_URL=https://vahla.co

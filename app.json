{
  "expo": {
    "name": "Vahla",
    "slug": "plategauge",
    "scheme": "plategauge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "bundleIdentifier": "com.plategauge.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Vahla uses the camera to photograph meals, read nutrition labels and scan food barcodes so you can log them.",
        "NSPhotoLibraryUsageDescription": "Vahla lets you choose a meal or nutrition label photo from your library to analyze it."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.plategauge.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Vahla",
      "shortName": "Vahla",
      "themeColor": "#FFFFFF",
      "backgroundColor": "#FFFFFF",
      "description": "Calorie and macro tracker. Tell it what you’re hungry for and see how to make it fit.",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Vahla uses the camera to photograph meals and scan food barcodes so you can log them.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vahla lets you pick a meal photo from your library to estimate its calories.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#1592FF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "description": "Calorie and macro tracker. Tell it what you’re hungry for and see how to make it fit."
  }
}
